// Golf Performance App — Schema
// Basado en Scoring Method de Will Robins + FlightScope range data

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============ CANCHAS ============

model Course {
  id        String           @id @default(cuid())
  name      String           @unique
  holes     CourseHole[]
  rounds    Round[]
  hcpTable  CourseHcpRange[]
  tees      CourseTee[]
  createdAt DateTime         @default(now())
}

// Tees con Slope / Course Rating / Par — para fórmula WHS cuando no hay tabla pre-cargada
model CourseTee {
  id           String  @id @default(cuid())
  course       Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId     String
  name         String  // BLANCO | AZUL | NEGRO | ROJO | AMARILLO | etc
  category     String  @default("CAB") // CAB | DAM
  slopeRating  Int     // típicamente 110-140
  courseRating Float   // típicamente 67-74 (para 18 hoyos)
  parTotal     Int     // total par del recorrido
  // Para 9-hoyos: ida/vuelta separados (opcional)
  slopeIda     Int?
  courseRatingIda Float?
  parIda       Int?
  slopeVuelta  Int?
  courseRatingVuelta Float?
  parVuelta    Int?
  notes        String?

  @@unique([courseId, name, category])
}

// Tabla "Hcp Juego" — index range → course handicap, por modalidad/tee
model CourseHcpRange {
  id        String  @id @default(cuid())
  course    Course  @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId  String
  modality  String  // MEDAL | STABLEFORD | MEDAL_IDA | MEDAL_VUELTA | STABLEFORD_IDA | STABLEFORD_VUELTA
  tee       String  @default("BLANCO") // BLANCO | AZUL | NEGRO | ROJO ...
  category  String  @default("CAB")    // CAB | DAM
  indexFrom Float   // ej -8.0
  indexTo   Float   // ej -7.6
  courseHcp Int     // ej -11

  @@index([courseId, modality, tee, category])
}

model CourseHole {
  id       String @id @default(cuid())
  course   Course @relation(fields: [courseId], references: [id], onDelete: Cascade)
  courseId String
  number   Int    // 1..18
  par      Int    // 3, 4 ó 5
  hcpHoyo  Int    // 1..18, índice de handicap del hoyo
  yards    Int?   // opcional

  @@unique([courseId, number])
}

// ============ JUGADORES ============

model Player {
  id              String        @id @default(cuid())
  name            String        @unique
  hcpIndex        Float?        // ej: 8.9
  isMe            Boolean       @default(false) // marca a Santiago
  lucilaMatricula String?       @unique // matrícula del socio La Lucila (para sync auto)
  lastHcpUpdate   DateTime?     // última actualización del HCP via sync
  // Niveles personales del Scoring Method — suben cuando lográs perfect run en una ronda
  enterSzYds        Int @default(50)  // yds que define "Enter SZ"
  downInSzStrokes   Int @default(3)   // golpes desde SZ que define "Down in SZ"
  onePuttCircleFt   Int @default(3)   // ft del 1-putt circle
  twoPuttCircleYds  Int @default(20)  // yds del 2-putt circle
  createdAt       DateTime      @default(now())
  roundEntries    RoundPlayer[]
}

// ============ RONDAS ============

model Round {
  id     String @id @default(cuid())
  course Course @relation(fields: [courseId], references: [id])
  courseId String
  date   DateTime
  mode   String // SOLO | TWO_P | THREE_P | FOUR_P
  modality String @default("MEDAL") // MEDAL | STABLEFORD | MATCH
  tee      String @default("BLANCO")
  // Configs Scoring Method (por ronda — clave de tu planilla)
  enterSzYds       Int @default(50)  // yds que define "Enter SZ"
  downInSzStrokes  Int @default(3)   // golpes desde SZ que define "Down in SZ"
  onePuttCircleFt  Int @default(6)   // ft del 1-putt circle
  twoPuttCircleYds Int @default(20)  // yds del 2-putt circle (para distribución putt)
  // 4P parejas
  pairs     String?  // JSON: [["playerId1","playerId2"],["playerId3","playerId4"]]
  notes     String?
  createdAt DateTime @default(now())

  players RoundPlayer[]
  holes   RoundHole[]
  bets    RoundBet[]
}

// Apuestas por ronda — Match/Medal/Stableford con plata
model RoundBet {
  id        String @id @default(cuid())
  round     Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId   String
  modality  String // MATCH | MATCH_IDA | MATCH_VUELTA | MEDAL | MEDAL_IDA | MEDAL_VUELTA | STABLEFORD | STABLEFORD_IDA | STABLEFORD_VUELTA
  amount    Float  // plata apostada (cada uno) — el ganador se lleva el total
  currency  String @default("ARS")

  @@unique([roundId, modality])
}

model RoundPlayer {
  id          String @id @default(cuid())
  round       Round  @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId     String
  player      Player @relation(fields: [playerId], references: [id])
  playerId    String
  hcpIndex    Float?  // index del jugador para esa fecha
  courseHcp   Int?    // course handicap del día principal (Medal Total) — para stroke allocation por hoyo
  modalityHcps Json?  // cache de CH por modalidad: { MEDAL: 6, STABLEFORD: 5, MEDAL_IDA: 3, ... }
  position    Int     // 1..4 orden de display

  holes RoundHole[]

  @@unique([roundId, playerId])
}

// Una fila por (ronda, jugador, hoyo)
model RoundHole {
  id            String      @id @default(cuid())
  round         Round       @relation(fields: [roundId], references: [id], onDelete: Cascade)
  roundId       String
  roundPlayer   RoundPlayer @relation(fields: [roundPlayerId], references: [id], onDelete: Cascade)
  roundPlayerId String
  holeNumber    Int // 1..18

  // Datos crudos cargados (todos opcionales — algunos jugadores solo cargan score)
  strokesToEnterSz       Int?
  distanceInRegYds       Int? // distancia al hoyo cuando entras a SZ
  strokesInsideSz        Int?
  putts                  Int?
  firstPuttDistanceFt    Int? // largo del 1er putt en ft
  puttMadeDistanceFt     Int? // largo del putt embocado
  puttsInside1PuttCircle Int?
  score                  Int? // golpes totales del hoyo

  @@unique([roundPlayerId, holeNumber])
}

// ============ RANGE / FLIGHTSCOPE ============

model RangeSession {
  id         String   @id @default(cuid())
  date       DateTime
  club       String   // DRIVER | WOOD_3 | HYBRID | IRON_7 | etc
  notes      String?
  imagePath  String?  // path al screenshot subido
  aiAnalysis String?  // markdown cacheado
  createdAt  DateTime @default(now())

  shots RangeShot[]
}

// Sesión de Purposeful Practice (PP) — Will Robins method
model PracticeSession {
  id        String   @id @default(cuid())
  date      DateTime
  notes     String?
  createdAt DateTime @default(now())
  drills    PracticeDrill[]
}

// Cada drill tiene: tipo, distancia (ft o yds), target alcanzado, intentos, mejor score
// types:
//   ONE_PUTT_CIRCLE   — 10 putts cortos desde N ft, # embocados
//   TWO_PUTT_CIRCLE   — 10 putts largos desde N ft, # quedados dentro 2-putt circle
//   CHIPPING          — N hoyos chipping desde N yds, suma de golpes
//   WEDGES_50 / WEDGES_70 / WEDGES_100 — 10 wedges desde N yds, # dentro 2-putt circle
//   GO_TO_CLUB        — N tiros con palo target a fairway, # en fairway
model PracticeDrill {
  id         String          @id @default(cuid())
  session    PracticeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId  String
  drillType  String          // ONE_PUTT_CIRCLE | TWO_PUTT_CIRCLE | CHIPPING | WEDGES_50 | WEDGES_70 | WEDGES_100 | GO_TO_CLUB
  distance   Int?            // ft o yds según drill
  club       String?         // Para GO_TO_CLUB: IRON_7 | IRON_6 | DRIVER | etc
  ppCode     String?         // A | B | 1 | 2 — qué PP plan code ataca
  target     Float?          // referencia (mejor marca o config)
  timesToAchieve  Int?       // veces a lograr el target (vienen del PP plan de la ronda)
  timesAchieved   Int?       // veces logradas en esta sesión (= # de attempts que cumplieron target)
  attemptsJson Json?         // array de scores: [8, 6, 9] o para chipping [3,4,2,3,3,2,3,3,2]
  leveledUp  Boolean         @default(false) // true si cumplió plan completo (timesAchieved >= timesToAchieve)
  notes      String?
}

model RangeShot {
  id           String       @id @default(cuid())
  session      RangeSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sessionId    String
  shotNumber   Int          // 1..N o 0 para AVG/DEV
  rowType      String       @default("SHOT") // SHOT | AVG | DEV

  carryYds           Float?
  rollYds            Float?
  totalYds           Float?
  lateralYds         Float?
  lateralDir         String? // L | R
  clubSpeedMph       Float?
  ballSpeedMph       Float?
  spinRpm            Int?
  spinAxisDeg        Float?
  spinAxisDir        String? // L | R
  spinLoftDeg        Float?
  smashFactor        Float?
  verticalAngleDeg   Float?
  horizontalAngleDeg Float?
  horizontalDir      String? // L | R
  aoaDeg             Float?
  heightFt           Float?
  timeSec            Float?
  shotType           String? // Hook | Slice | Push | Pull | Straight | etc

  @@unique([sessionId, shotNumber, rowType])
}
